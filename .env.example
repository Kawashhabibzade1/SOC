# ──────────────────────────────────────────────
# SOC Radar - Environment Configuration
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ──────────────────────────────────────────────

# MariaDB connection settings
# Use the Docker host IP if the collector runs on the host
# and MariaDB is exposed via a port mapping (e.g., -p 3306:3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=soc_collector
DB_PASSWORD=StrongPassword123!
DB_NAME=soc_radar

# Log source: 'journalctl' (default, systemd service logs) or 'auth' (tail auth/service log files)
LOG_SOURCE=journalctl

# Comma-separated files used when LOG_SOURCE=auth
AUTH_LOG_FILES=/var/log/auth.log,/var/log/vsftpd.log,/var/log/xrdp.log,/var/log/xrdp-sesman.log,/var/log/fail2ban.log

# Comma-separated systemd units used when LOG_SOURCE=journalctl
JOURNAL_UNITS=ssh,sshd,fail2ban,vsftpd,xrdp,xrdp-sesman
