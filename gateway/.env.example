# ──────────────────────────────────────────────
# SOC Radar Gateway - Environment Configuration
# cp .env.example .env   then fill in your values
# ──────────────────────────────────────────────

# Gateway port
PORT=3001

# The URL of your Next.js frontend (Vercel deployment).
# Used to scope CORS — only this origin can call the public REST API.
# Set to your actual Vercel URL in production.
FRONTEND_ORIGIN=https://your-app.vercel.app

# Shared secret between Phase 1 (collector) and Phase 2 (gateway).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=changeme-use-a-real-secret

# ── MariaDB (same soc_radar database from Phase 1) ──
# Inside Docker, use the container name as the hostname (thanks to the shared network)
DB_HOST=nextcloud-db
DB_PORT=3306
DB_USER=soc_collector
DB_PASSWORD=StrongPassword123!
DB_NAME=soc_radar

# ── Admin credentials ────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=soc-radar-2026
# Generate TOTP secret with: node generate-2fa.js
TOTP_SECRET=
